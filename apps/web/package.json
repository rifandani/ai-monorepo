{
  "name": "@workspace/web",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Bulletproof Next.js 15 AI template",
  "author": "Tri Rizeki Rifandani",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "cp .env.dev .env.local && next dev --port 3002",
    "dev:prod": "cp .env.prod .env.local && next dev --port 3002",
    "dev:turbo": "cp .env.dev .env.local && next dev --turbopack --port 3002",
    "build": "cp .env.dev .env.local && next build",
    "build:prod": "cp .env.prod .env.local && next build",
    "build:prod:analyze": "cp .env.prod .env.local && dotenvx run --env ANALYZE=true -- next build",
    "start": "next start",
    "mcp:inspector": "npx -y @modelcontextprotocol/inspector",
    "mcp:inspector-muppet": "bun muppet-kit inspector"
  },
  "dependencies": {
    "@ai-sdk/google": "2.0.4",
    "@dotenvx/dotenvx": "1.48.4",
    "@formkit/auto-animate": "0.8.2",
    "@google/generative-ai": "0.24.1",
    "@hookform/resolvers": "5.2.1",
    "@internationalized/date": "3.8.2",
    "@modelcontextprotocol/sdk": "1.17.2",
    "@next-safe-action/adapter-react-hook-form": "2.0.0",
    "@next/bundle-analyzer": "15.4.6",
    "@nosecone/next": "1.0.0-beta.10",
    "@radix-ui/react-scroll-area": "1.2.9",
    "@reactuses/core": "6.0.6",
    "@t3-oss/env-nextjs": "0.13.8",
    "@tanstack/react-query": "5.85.0",
    "@tanstack/react-query-devtools": "5.85.0",
    "@workspace/core": "workspace:*",
    "ai": "5.0.10",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.4.2",
    "katex": "0.16.22",
    "ky": "1.8.2",
    "marked": "16.2.1",
    "mermaid": "11.9.0",
    "motion": "12.23.12",
    "next": "15.4.6",
    "next-intl": "4.3.4",
    "next-safe-action": "8.0.8",
    "next-themes": "0.4.6",
