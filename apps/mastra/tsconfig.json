{
  "extends": "@workspace/typescript-config/node.json",
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@workspace/core/*": ["../../packages/core/src/*"]
    },
    "types": ["bun-types"]
  },
  "include": ["**/*.ts", "**/*.spec.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", ".mastra"]
}
