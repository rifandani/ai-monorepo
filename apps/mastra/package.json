{
  "name": "@workspace/mastra",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Bulletproof Mastra template",
  "author": "Tri Rizeki Rifandani",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:pull": "drizzle-kit pull",
    "db:push": "drizzle-kit push",
    "db:gen": "dotenvx run -- drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed-images": "dotenvx run -- bun src/core/db/seed-images.ts",
    "db:studio": "drizzle-kit studio --port 3003 --verbose",
    "test": "dotenvx run -- vitest",
    "dev": "mastra dev",
    "build": "mastra build",
    "mcp:inspector": "npx -y @modelcontextprotocol/inspector"
  },
  "dependencies": {
    "@ai-sdk/google": "1.2.19",
    "@browserbasehq/stagehand": "2.3.1",
    "@dotenvx/dotenvx": "1.45.2",
    "@google/generative-ai": "0.24.1",
    "@mastra/core": "0.10.8",
    "@mastra/evals": "0.10.5",
    "@mastra/mcp": "0.10.5",
    "@mastra/memory": "0.11.0",
    "@mastra/pg": "0.12.0",
    "@opentelemetry/api-logs": "0.202.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.202.0",
    "@opentelemetry/resources": "2.0.1",
    "@opentelemetry/sdk-logs": "0.202.0",
    "@opentelemetry/semantic-conventions": "1.34.0",
    "@t3-oss/env-core": "0.13.8",
    "@workspace/core": "workspace:*",
    "ai": "4.3.16",
    "drizzle-orm": "0.44.2",
    "drizzle-seed": "0.3.1",
    "drizzle-zod": "0.8.2",
    "gray-matter": "4.0.3",
    "mastra": "0.10.8",
    "pg": "8.16.0",
    "radashi": "12.5.1",
    "remark-parse": "11.0.0",
    "ts-pattern": "5.7.1",
    "type-fest": "4.41.0",
    "unified": "11.0.5",
    "zod": "3.25.64"
  },
  "devDependencies": {
    "@types/bun": "1.2.16",
    "@types/node": "22.15.31",
    "@types/pg": "8.15.4",
    "@types/unist": "3.0.3",
    "@workspace/typescript-config": "workspace:*",
    "drizzle-kit": "0.31.1",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
