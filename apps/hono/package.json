{
  "name": "@workspace/hono",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Bulletproof Hono 4 AI template",
  "author": "Tri Rizeki Rifandani",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:pull": "dotenvx run --env-file=.env.dev -- drizzle-kit pull",
    "db:push": "dotenvx run --env-file=.env.dev -- drizzle-kit push --verbose --strict",
    "db:gen": "dotenvx run --env-file=.env.dev -- drizzle-kit generate",
    "db:migrate": "dotenvx run --env-file=.env.dev -- drizzle-kit migrate",
    "db:seed-images": "bun src/core/db/seed-images.ts",
    "db:studio": "dotenvx run --env-file=.env.dev -- drizzle-kit studio --port 3003 --verbose",
    "test": "vitest",
    "dev": "bun run --env-file=.env.dev --hot --preload src/instrumentation.ts src/bun.ts",
    "dev:prod": "bun run --env-file=.env.prod --hot --preload src/instrumentation.ts src/bun.ts",
    "node:dev": "dotenvx run --env-file=.env.dev -- tsx watch --import src/instrumentation.ts src/node.ts",
    "node:dev:prod": "dotenvx run --env-file=.env.prod -- tsx watch --import src/instrumentation.ts src/node.ts",
    "node:build": "dotenvx run --env-file=.env.dev -- tsc -p .",
    "node:build:prod": "dotenvx run --env-file=.env.prod -- tsc -p .",
    "node:start": "dotenvx run --env-file=.env.dev -- node ./dist/node.js",
    "node:start:prod": "dotenvx run --env-file=.env.prod -- node ./dist/node.js",
    "mcp:inspector": "npx -y @modelcontextprotocol/inspector",
    "mcp:inspector-muppet": "bun muppet-kit inspector",
    "mcp:stream:example:server": "node ../../node_modules/@modelcontextprotocol/sdk/dist/esm/examples/server/simpleStreamableHttp.js",
    "mcp:stream:example:client": "node ../../node_modules/@modelcontextprotocol/sdk/dist/esm/examples/client/simpleStreamableHttp.js",
    "mcp:stdio:server:js:build": "dotenvx run --env-file=.env.dev -- tsc src/mcp/stdio/server.ts --outDir src/mcp/stdio/dist --target es2023 --module nodenext",
    "mcp:stdio:server:js:run": "dotenvx run --env-file=.env.dev -- node src/mcp/stdio/dist/server.js",
    "mcp:stdio:server": "dotenvx run --env-file=.env.dev -- tsx src/mcp/stdio/server.ts",
    "mcp:stdio:client": "dotenvx run --env-file=.env.dev -- tsx src/mcp/stdio/client.ts",
    "mcp:markitdown:client": "dotenvx run --env-file=.env.dev -- tsx src/mcp/markitdown-client/client.ts",
    "evalite": "evalite watch",
    "eval": "dotenvx run --env-file=.env.dev -- tsx evals/runeval.ts",
    "eval:view": "promptfoo view -y",
    "eval:clean": "rm -rf evals/.results && rm -rf ~/.promptfoo/cache",
    "redteam": "dotenvx run --env-file=.env.dev -- tsx evals/runredteam.ts",
    "redteam:view": "promptfoo redteam report"
  },
  "dependencies": {
    "@ai-sdk/google": "2.0.4",
    "@dotenvx/dotenvx": "1.48.4",
    "@google/generative-ai": "0.24.1",
    "@hono/node-server": "1.18.2",
    "@hono/otel": "0.4.0",
    "@hono/zod-openapi": "1.1.0",
    "@hono/zod-validator": "0.7.2",
    "@modelcontextprotocol/sdk": "1.17.2",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/api-logs": "0.203.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.203.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.203.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.203.0",
    "@opentelemetry/instrumentation-dns": "0.47.0",
    "@opentelemetry/instrumentation-http": "0.203.0",
    "@opentelemetry/instrumentation-net": "0.47.0",
    "@opentelemetry/instrumentation-pg": "0.55.0",
    "@opentelemetry/instrumentation-runtime-node": "0.17.0",
    "@opentelemetry/instrumentation-undici": "0.14.0",
    "@opentelemetry/resources": "2.0.1",
    "@opentelemetry/sdk-logs": "0.203.0",
    "@opentelemetry/sdk-metrics": "2.0.1",
    "@opentelemetry/sdk-node": "0.203.0",
    "@opentelemetry/sdk-trace-node": "2.0.1",
    "@opentelemetry/semantic-conventions": "1.36.0",
    "@scalar/hono-api-reference": "0.9.13",
    "@scalar/openapi-to-markdown": "0.2.26",
    "@t3-oss/env-core": "0.13.8",
    "@workspace/core": "workspace:*",
    "ai": "5.0.10",
    "compromise": "14.14.4",
    "difflib": "0.2.4",
    "drizzle-orm": "0.44.4",
    "drizzle-seed": "0.3.1",
    "drizzle-zod": "0.8.3",
    "fetch-to-node": "2.1.0",
    "hono": "4.9.1",
    "hono-rate-limiter": "0.4.2",
    "keyword-extractor": "0.0.28",
    "ky": "1.8.2",
    "mathjs": "14.6.0",
    "pg": "8.16.3",
    "radashi": "12.6.1",
    "sentiment": "5.0.2",
    "ts-pattern": "5.8.0",
    "type-fest": "4.41.0",
    "zod": "4.0.17",
    "zod-validation-error": "4.0.1"
  },
  "devDependencies": {
    "@types/bun": "1.2.20",
    "@types/node": "24.2.1",
    "@types/pg": "8.15.5",
    "@workspace/typescript-config": "workspace:*",
    "autoevals": "0.0.130",
    "drizzle-kit": "0.31.4",
    "evalite": "0.11.4",
    "promptfoo": "0.117.5",
    "tsx": "4.20.4",
    "typescript": "5.9.2",
    "unpdf": "1.1.0",
    "unstorage": "1.17.0",
    "vitest": "3.2.4"
  }
}
