{
  "name": "@workspace/hono",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Bulletproof Hono 4 AI template",
  "author": "Tri Rizeki Rifandani",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:pull": "drizzle-kit pull",
    "db:push": "drizzle-kit push --verbose --strict",
    "db:gen": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed-images": "bun src/core/db/seed-images.ts",
    "db:studio": "drizzle-kit studio --port 3003 --verbose",
    "test": "vitest",
    "dev": "bun run --env-file=.env.dev --hot --preload src/instrumentation.ts src/bun.ts",
    "dev:prod": "bun run --env-file=.env.prod --hot --preload src/instrumentation.ts src/bun.ts",
    "node:dev": "dotenvx run --env-file=.env.dev -- tsx watch --import src/instrumentation.ts src/node.ts",
    "node:dev:prod": "dotenvx run --env-file=.env.prod -- tsx watch --import src/instrumentation.ts src/node.ts",
    "node:build": "dotenvx run --env-file=.env.dev -- tsc -p .",
    "node:build:prod": "dotenvx run --env-file=.env.prod -- tsc -p .",
    "node:start": "dotenvx run --env-file=.env.dev -- node ./dist/node.js",
    "node:start:prod": "dotenvx run --env-file=.env.prod -- node ./dist/node.js",
    "mcp:inspector": "npx -y @modelcontextprotocol/inspector",
    "mcp:inspector-muppet": "bun muppet-kit inspector",
    "mcp:stream:example:server": "node ../../node_modules/@modelcontextprotocol/sdk/dist/esm/examples/server/simpleStreamableHttp.js",
    "mcp:stream:example:client": "node ../../node_modules/@modelcontextprotocol/sdk/dist/esm/examples/client/simpleStreamableHttp.js",
    "mcp:stdio:server:js:build": "dotenvx run -- tsc src/mcp/stdio/server.ts --outDir src/mcp/stdio/dist --target es2023 --module nodenext",
    "mcp:stdio:server:js:run": "dotenvx run -- node src/mcp/stdio/dist/server.js",
    "mcp:stdio:server": "dotenvx run -- tsx src/mcp/stdio/server.ts",
    "mcp:stdio:client": "dotenvx run -- tsx src/mcp/stdio/client.ts",
    "mcp:markitdown:client": "dotenvx run -- tsx src/mcp/markitdown-client/client.ts",
    "evalite": "evalite watch",
    "eval": "dotenvx run -- tsx evals/runeval.ts",
    "eval:view": "promptfoo view -y",
    "eval:clean": "rm -rf evals/.results && rm -rf ~/.promptfoo/cache",
    "redteam": "dotenvx run -- tsx evals/runredteam.ts",
    "redteam:view": "promptfoo redteam report"
  },
  "dependencies": {
    "@ai-sdk/google": "1.2.22",
    "@dotenvx/dotenvx": "1.47.6",
    "@google/generative-ai": "0.24.1",
    "@hono/node-server": "1.14.4",
    "@hono/otel": "0.2.2",
    "@hono/zod-openapi": "1.0.0-beta.1",
    "@hono/zod-validator": "0.7.1",
    "@modelcontextprotocol/sdk": "1.13.2",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/api-logs": "0.203.0",
    "@opentelemetry/auto-instrumentations-node": "0.62.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.203.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.203.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.203.0",
    "@opentelemetry/resources": "2.0.1",
    "@opentelemetry/sdk-logs": "0.203.0",
    "@opentelemetry/sdk-metrics": "2.0.1",
    "@opentelemetry/sdk-node": "0.203.0",
    "@opentelemetry/sdk-trace-node": "2.0.1",
    "@opentelemetry/semantic-conventions": "1.36.0",
    "@scalar/hono-api-reference": "0.9.10",
    "@scalar/openapi-to-markdown": "0.2.21",
    "@t3-oss/env-core": "0.13.8",
    "@workspace/core": "workspace:*",
    "ai": "4.3.18",
    "compromise": "14.14.4",
    "difflib": "0.2.4",
    "drizzle-orm": "0.44.3",
    "drizzle-seed": "0.3.1",
    "drizzle-zod": "0.8.2",
    "fetch-to-node": "2.1.0",
    "hono": "4.7.11",
    "hono-rate-limiter": "0.4.2",
    "keyword-extractor": "0.0.28",
    "mathjs": "14.5.3",
    "pg": "8.16.3",
    "radashi": "12.6.0",
    "sentiment": "5.0.2",
    "ts-pattern": "5.7.1",
    "type-fest": "4.41.0",
    "zod": "3.25.64",
    "zod-validation-error": "3.5.3"
  },
  "devDependencies": {
    "@types/bun": "1.2.18",
    "@types/node": "22.15.31",
    "@types/pg": "8.15.4",
    "@workspace/typescript-config": "workspace:*",
    "autoevals": "0.0.130",
    "drizzle-kit": "0.31.4",
    "evalite": "0.11.4",
    "promptfoo": "0.116.7",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "unpdf": "1.0.6",
    "unstorage": "1.16.1",
    "vitest": "3.2.4"
  }
}
