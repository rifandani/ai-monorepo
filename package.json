{
  "name": "ai-monorepo",
  "version": "1.0.0",
  "author": "Tri Rizeki Rifandani",
  "devDependencies": {
    "@biomejs/biome": "2.0.5",
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@types/node": "22.15.31",
    "@workspace/typescript-config": "workspace:*",
    "husky": "9.1.7",
    "npm-run-all2": "8.0.4",
    "rimraf": "6.0.1",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "ultracite": "5.0.20"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "description": "AI Monorepo",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.2.17",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "clean": "rimraf --glob \"**/node_modules\" \"**/dev-dist\" \"**/dist\" \"**/build\" \"**/html\" \"**/playwright\" \"**/playwright-report\" \"**/playwright-test-results\" \"**/bun.lock\" \"**/.next\" && bun install",
    "compose:up": "docker compose up --build",
    "format": "ultracite format",
    "format:unsafe": "ultracite format --unsafe",
    "lint": "ultracite lint",
    "lint-typecheck": "run-p lint hono:typecheck web:typecheck mastra:typecheck",
    "hono": "bun --elide-lines=0 --filter @workspace/hono",
    "web": "bun --elide-lines=0 --filter @workspace/web",
    "mastra": "bun --elide-lines=0 --filter @workspace/mastra",
    "hono:ci": "bun --filter @workspace/hono",
    "web:ci": "bun --filter @workspace/web",
    "mastra:ci": "bun --filter @workspace/mastra",
    "hono:typecheck": "bun hono:ci typecheck",
    "web:typecheck": "bun web:ci typecheck",
    "mastra:typecheck": "bun mastra:ci typecheck"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "@playwright/browser-chromium",
    "better-sqlite3",
    "esbuild",
    "protobufjs",
    "sharp"
  ],
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
