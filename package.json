{
  "name": "ai-monorepo",
  "version": "1.0.0",
  "author": "Tri Rizeki Rifandani",
  "devDependencies": {
    "@biomejs/biome": "2.1.4",
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@types/node": "24.2.1",
    "@workspace/typescript-config": "workspace:*",
    "husky": "9.1.7",
    "npm-run-all2": "8.0.4",
    "rimraf": "6.0.1",
    "tsx": "4.20.4",
    "typescript": "5.9.2",
    "ultracite": "5.1.2"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "description": "AI Monorepo Template",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.2.20",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "compose:up": "docker compose -f ./docker/docker-compose.yml up --build",
    "clean": "rimraf --glob \"**/node_modules\" \"**/dev-dist\" \"**/dist\" \"**/build\" \"**/html\" \"**/playwright\" \"**/playwright-report\" \"**/playwright-test-results\" \"**/bun.lock\" \"**/.next\" && bun install",
    "bump-deps": "bunx npm-check-updates --deep -u --peer --dep prod,dev,optional,packageManager,peer -x @babel*,tamagui",
    "cs": "changeset",
    "cs:v": "changeset version",
    "format": "ultracite format",
    "format:unsafe": "ultracite format --unsafe",
    "lint": "ultracite lint",
    "lint-typecheck": "run-p lint hono:typecheck web:typecheck mastra:typecheck",
    "hono": "bun --elide-lines=0 --filter @workspace/hono",
    "web": "bun --elide-lines=0 --filter @workspace/web",
    "mastra": "bun --elide-lines=0 --filter @workspace/mastra",
    "hono:ci": "bun --filter @workspace/hono",
    "web:ci": "bun --filter @workspace/web",
    "mastra:ci": "bun --filter @workspace/mastra",
    "hono:typecheck": "bun hono:ci typecheck",
    "web:typecheck": "bun web:ci typecheck",
    "mastra:typecheck": "bun mastra:ci typecheck"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "@playwright/browser-chromium",
    "@tailwindcss/oxide",
    "better-sqlite3",
    "esbuild",
    "protobufjs",
    "sharp",
    "vue-demi"
  ],
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
